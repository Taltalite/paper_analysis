# Local secrets and private configuration
.env
.env.*
!.env.example
*.env
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
secrets.*
config/*.local.json
config/*secret*.json
/config/app.json

# Python caches and virtual environments
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
/lib/

# Tooling caches and local runtime data
.uv-cache/
.cache/
.data/
*.log
*.sqlite
*.sqlite3
*.db

# Parser/runtime generated artifacts
input/.paper_analysis_assets/
**/.paper_analysis_assets/

# Frontend artifacts
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/

# OS and editor files
.DS_Store
.idea/
.vscode/

# Large local inputs that often contain private source material
*.pdf
/ref_baseline/
/input/*
!/input/sample_paper.txt

# Local outputs from repeatable evaluation runs
evals/runs/
output/
# Archives and machine-specific manifests stay local.
/evals/archive/
/evals/baselines/**/baseline_manifest.json

# Local coding-agent instructions, plans, and workspace settings.
# Application agents and prompts under src/ remain versioned.
.codex
.agents/
.claude/
/[Aa][Gg][Ee][Nn][Tt][Ss].md
/[Aa][Gg][Ee][Tt][Nn][Ss].md
/[Pp][Ll][Aa][Nn].md
/[Pp][Ll][Aa][Nn][Ss].md

# Explanatory documents and experiment records are local, not runtime inputs.
/docs/
