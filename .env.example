# 文本模型：Kimi Code 订阅接口。密钥仅写入本地 .env。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding
KIMI_TEMPERATURE=1

# 视觉模型：阿里云百炼 / Model Studio，独立于 Kimi 订阅。
# 将百炼 API Key 填入 VISION_API_KEY；本项目不读取 DASHSCOPE_API_KEY。
# 以下默认北京区：务必将 YOUR_WORKSPACE_ID 替换为控制台的业务空间 ID。
# API Key、业务空间和接口地域须对应；不要添加 /chat/completions。
# 新加坡区：https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-flash
VISION_TEMPERATURE=0.2
VISION_REQUEST_TIMEOUT=240
# 复杂图表可对比 qwen3-vl-plus：只修改 VISION_MODEL，非自动升级/回退。
# 不保证免费：额度、地域价格及模型权限以控制台为准。
# 三项 VISION_API_KEY / VISION_BASE_URL / VISION_MODEL 必须完整填写。
# KIMI_VISION_MODEL 留空；图像提取和问答原图复核均使用独立 Qwen 配置。
KIMI_VISION_MODEL=
# 官方接入：https://help.aliyun.com/zh/model-studio/first-api-call-to-qwen
# 模型说明：https://help.aliyun.com/zh/model-studio/qwen3-vl-flash
# 若使用千问AI平台 Token Plan，需同时替换端点与模型，并填写该套餐专属密钥：
# VISION_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
# VISION_MODEL=qwen3.8-flash
# Token Plan 不支持上述 qwen3-vl-flash 时会返回 model_not_found，不能混用。
# 套餐模型：https://platform.qianwenai.com/docs/token-plan/overview

CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
