# 文本：Kimi Code 接口，密钥仅填写本地 .env。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=k3-256k
KIMI_TEMPERATURE=1
# 原生推理强度与 light/standard/deep 执行额度独立。
KIMI_REASONING_EFFORT=high
KIMI_VISION_MODEL=

# 图像提取与原图复核：独立千问 Token Plan 配置。
# 密钥、端点、型号必须属于同一服务及账号权限；本项目不读取 DASHSCOPE_API_KEY。
VISION_API_KEY=
VISION_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1
VISION_MODEL=qwen3.8-flash
VISION_TEMPERATURE=0.9
VISION_MAX_OUTPUT_TOKENS=16384
VISION_REQUEST_TIMEOUT=240
# 文本单次 HTTP 超时默认 120 秒；需要时显式设置。
# TEXT_REQUEST_TIMEOUT=300

# 如果改用百炼 Model Studio，成组替换密钥、端点与该服务支持的模型。
# VISION_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen3-vl-flash

CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
